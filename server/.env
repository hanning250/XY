# ISUP 告警平台 —— 服务配置示例
# 复制为 server/.env 后按需修改。所有变量以 ISUP_ 开头。

# ---------------- 服务 ----------------
ISUP_HOST=0.0.0.0
ISUP_PORT=8088
ISUP_DEBUG=true

# 对外暴露的基址，用于给甲方 IT 部门拼**绝对 URL**
# ★ 部署到服务器后必须改成真实域名/IP
# ⚠️ 留在 127.0.0.1 的后果：接口返回的图片/视频 URL 会指向**甲方自己的本机**，
#    对方全部下载失败，而接口本身仍返回 200（看起来一切正常）。
#    启动日志会对本机地址给出告警；也可用 /openapi/v1/health 的
#    data.media_base_url 自查。
ISUP_PUBLIC_BASE_URL=http://192.168.1.221:8088

# ---------------- ★ 内部看板接口 / 前端托管 ----------------
# true  = 注册 /api/*（前端看板必需）
# false = 仅暴露 /openapi/v1/*（对外交付模式）
ISUP_ENABLE_INTERNAL_API=true
ISUP_ENABLE_WEB_UI=true

# ---------------- ★ 鉴权（预留设计，见 docs §5）----------------
# jwt    : 登录页 + JWT（默认）
# apikey : 内部 API 也要求 Key
ISUP_AUTH_MODE=jwt

# JWT（生产环境必须改成随机值：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"）
ISUP_JWT_SECRET=local-dev-change-me-please-use-random
# 3 年：一次登录长期有效（未清 Cookie / 未改密前无需反复登录）
ISUP_JWT_EXPIRE_MINUTES=1576800

# Web 管理员（启动时自动创建/同步）
ISUP_ADMIN_USERNAME=admin
ISUP_ADMIN_PASSWORD=STSXY304

# ---------------- ★ CORS（安全审查新增）----------------
# 允许跨域访问的前端来源（逗号分隔）。留空 = 不开 CORS（推荐，同源部署无需跨域）。
# 开发期前后端分离时才需要配置：
# ISUP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ISUP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---------------- ★ 审计日志保留期（安全审查新增）----------------
# api_audit_log 按天清理，0 = 保留全部
ISUP_AUDIT_RETENTION_DAYS=90

# ---------------- ★ 告警聚合（见 docs §3）----------------
# 聚合等待窗口（秒）。
#   0  = **不做窗口聚合**，每条告警独立、入库即 complete（2026-09-17 起默认）
#   >0 = 等待图片到达再封板
# 说明：屏蔽掉每秒刷屏的海康 IO 告警后，不再需要窗口聚合。
ISUP_CORRELATE_WINDOW_SECONDS=0
ISUP_CORRELATE_SWEEP_INTERVAL=1

# ★ 图片就近匹配容差（秒）
# 图片可能比告警早到（实测早 19ms）或晚到几十秒，用它做时间匹配。
ISUP_IMAGE_MATCH_TOLERANCE_SECONDS=120

# ---------------- ★ 告警去重 ----------------
# 同一 (设备, 通道, 事件类型) 在该秒数内重复上报时合并为一条（累加 repeatCount）。
#
# ⚠️ 2026-09-20 起默认 0（关闭），与同事实现对齐：
#    同事（src/Backend）是「每条回调都入库 + 都广播」，没有任何合并。
#    实测 box001 的 AIOP_Polling_Snap 是**轮询抓拍**模式 ——
#    只要画面里还有未穿防护服的人，设备就每 6 秒重复上报一次。
#    开启去重会把后续上报静默吞掉（前端收不到推送）。
#
#    代价：约 600 条/小时、14400 条/天。用下面的告警保留期兜底。
#    设为 > 0 可恢复合并行为。
ISUP_DEDUP_WINDOW_SECONDS=0

# ---------------- ★ 告警过滤（屏蔽噪音设备）----------------
# 设备黑名单（逗号分隔）。留空 = 不过滤。
# 例：ISUP_IGNORE_DEVICES=SomeNoisyCam
ISUP_IGNORE_DEVICES=

# 事件类型黑名单（逗号分隔），如 IO
ISUP_IGNORE_EVENT_TYPES=

# 白名单：非空时**只接受**这些设备（优先级高于黑名单）
# ISUP_ALLOW_DEVICES=box001

# ---------------- ★ 软件授权（有效期 1 年）----------------
# 客户现场**首次启动**即激活：到期日 = 首次启动时间 + 天数。
# 记录写在 data/license.json（打包脚本排除 data/，重新解包即重新起算）。
#
# 到期行为：全面停用 —— 除登录/授权/健康检查，业务接口一律 403，
# 前端只剩「授权已到期」页，管理员输入授权码续期后立即恢复。
ISUP_LICENSE_DAYS=365

# 是否启用到期拦截。true=全面停用（正式交付）；false=只提示不拦（演示/排障）
ISUP_LICENSE_ENFORCE=true

# ★ 授权码签名密钥：交付前务必改成自己的密钥！
#   生成端 scripts/make_license_code.py 必须用同一份密钥，否则客户机校验不过。
ISUP_LICENSE_SECRET=isup-license-change-me

# 授权记录文件路径（留空 = <项目根>/data/license.json）
# ISUP_LICENSE_FILE=

# ---------------- ★ 界面缩放（现场大屏适配）----------------
# 现场 1920×1080 大屏实测 80% 刚好一屏看完（不用手动缩放浏览器）。
# 前端启动时从 /api/auth/config 取该值写进 <html style="zoom">，
# 改这里**重启后端 + 刷新页面**即可，无需重新构建前端。填 1 = 不缩放。
#
# ⚠️ 布局里不要用 vh/vw 单位：根元素 zoom 下 vh 不跟着缩放，
#    100vh 只会占到屏幕高度的 80%（本项目已全部改用百分比）。
ISUP_UI_SCALE=0.8

# ---------------- ★ 审计日志保留期 ----------------
# api_audit_log 的清理天数。0 = 不清理。
ISUP_AUDIT_RETENTION_DAYS=90

# ---------------- ★ 保留期（防止磁盘/数据库膨胀）----------------
# 媒体文件保留天数（storage 图片 / media/video 视频 / outputFiles）
ISUP_MEDIA_RETENTION_DAYS=30

# SDK 日志保留天数
ISUP_LOG_RETENTION_DAYS=7

# ★ 告警**记录**保留天数。
# 因为关闭了去重，轮询型设备会持续产生重复告警，必须靠它兜底。
# 超期记录连同其图片/视频文件一起删除。0 = 不清理。
ISUP_ALARM_RETENTION_DAYS=30

# 按哪个时间判断超期：alarm_time（告警发生时间）/ created_at（入库时间）
ISUP_ALARM_RETENTION_BY=alarm_time

# 启动时是否立即跑一次清理
ISUP_CLEANUP_ON_STARTUP=true

# 定时清理间隔（小时）。0 = 关闭定时清理
ISUP_CLEANUP_INTERVAL_HOURS=24

# ---------------- ★ 开放 API：增量同步（甲方每 10 分钟拉一次）----------------
# 服务端按"整 N 分钟"对齐计算窗口。甲方传 window=10m 即可，不用自己算时间。
ISUP_SYNC_WINDOW_MINUTES=10

# 保护期（秒）：只返回「已经过去 N 秒」的数据。
# 目的是保证窗口末尾的告警视频已转码完成，甲方不会拿到 video_url=null。
ISUP_SYNC_GRACE_SECONDS=60

# 开放 API 限流（次/分钟/IP）。0 = 不限流（需由反向代理负责限流）。
# 甲方补拉积压时会连发多个分页请求，阈值过低会让对方看到 429「取数失败」。
ISUP_OPEN_API_RATE_LIMIT_PER_MIN=600

# ---------------- 图片存储 ----------------
# 按 yyyy/mm/dd 分层（原实现是 storage/ 平铺，文件多后会卡）
ISUP_STORAGE_DATE_PARTITION=true

# ---------------- ★ 视频 Provider（见 docs §6）----------------
# mock : 返回样例视频 —— 同事的解码服务未就绪时用它跑通前端
# file : 同事产出 MP4 文件，我方只托管 URL（★ 最理想）
# http : 同事提供 HTTP 接口，我方代理
ISUP_VIDEO_PROVIDER=file

# file / http 模式下，同事的解码服务地址
ISUP_VIDEO_SERVICE_BASE=http://127.0.0.1:9000

# 视频会话 TTL（秒）：到期自动回收，防句柄/文件泄漏
ISUP_VIDEO_SESSION_TTL_SECONDS=300

# ---- ISAPI 录像下载（边缘算力盒子 192.168.1.64）----
# 开启后抓取走 ISAPI，失败自动降级到 SDK 回放。
ISUP_VIDEO_USE_ISAPI=true
ISUP_ISAPI_HOST=192.168.1.64
ISUP_ISAPI_PORT=80
ISUP_ISAPI_USERNAME=admin
# 盒子网页管理员密码（与现场不一致时请改）
ISUP_ISAPI_PASSWORD=STSXY304
# 同时下载路数（实测设备支持 3 路，偶发失败靠重试兜住）
ISUP_ISAPI_MAX_CONCURRENT=3
ISUP_ISAPI_DOWNLOAD_TIMEOUT=60
# 单段最大允许下载秒数（防误传超大区间）
ISUP_ISAPI_MAX_SEGMENT_SECONDS=180
# HTTP alertStream 兜底（与 HCNet 布防同时开会重复告警）
ISUP_ISAPI_ALERT_ENABLE=false
ISUP_ISAPI_DEVICE_ID=box001
# 设备网路 SDK（HCNetSDK）布防收 ISAPI 事件；库已拷进项目 lib/hcnetsdk
ISUP_HCNETSDK_ENABLE=true
ISUP_HCNETSDK_DIR=/home/sy304/isup-alarm/lib/hcnetsdk
# 登录模式 1=ISAPI（默认）。ISAPI 必须走 HTTP 口（通常 80）；8000 是私有协议口会 Login err=9
ISUP_HCNETSDK_LOGIN_MODE=1
ISUP_HCNETSDK_PORT=80
# 实况：PlayCtrl 真预览（子进程）。失败自动回退 ISAPI
ISUP_LIVE_USE_PLAYCTRL=true
ISUP_LIVE_PLAYCTRL_LOGIN_MODE=0
ISUP_LIVE_PLAYCTRL_PORT=8000
ISUP_LIVE_PLAYCTRL_INTERVAL=0.04
