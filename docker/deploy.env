# ISUP 告警平台 —— 本机部署环境（192.168.1.221）
#
# 现场设备：
#   平台本机          192.168.1.221
#   边缘算力盒子      192.168.1.64   （ISUP 注册到本机；录像 ISAPI 也指这里）
#   摄像头            192.168.1.10  （一般经盒子上报，平台不直连摄像头）

# ---- ISUP 核心 ----
ISUP_SERVER_IP=192.168.1.221
ISUP_KEY=STSXY304
ISUP_LISTEN_IP=0.0.0.0
ISUP_CMS_PORT=7661
ISUP_AMS_TCP_PORT=7663
ISUP_AMS_UDP_PORT=7662
ISUP_SS_PORT=6011
ISUP_SMS_PORT=7665
ISUP_SMS_BACK_PORT=8000

# ---- Web ----
ISUP_HOST=0.0.0.0
ISUP_PORT=8088
ISUP_PUBLIC_BASE_URL=http://192.168.1.221:8088
ISUP_DEBUG=false

# ---- 功能开关 ----
ISUP_ENABLE_ISUP_SDK=true
ISUP_ENABLE_INTERNAL_API=true
ISUP_ENABLE_WEB_UI=true

# ---- 鉴权（JWT 登录；开放 API 一律要求 X-API-Key）----
ISUP_AUTH_MODE=jwt
ISUP_JWT_SECRET=local-dev-change-me-please-use-random
# 30 天：未断电/未清 Cookie 时无需反复登录（甲方反馈原 12 小时过短）
ISUP_JWT_EXPIRE_MINUTES=43200
# Web 登录账号（启动时自动创建/同步）
ISUP_ADMIN_USERNAME=admin
ISUP_ADMIN_PASSWORD=STSXY304

# ---- 授权（本机关闭强制，避免挡业务）----
ISUP_LICENSE_DAYS=365
ISUP_LICENSE_ENFORCE=false
ISUP_LICENSE_SECRET=local-license-secret-change-me

# ---- 告警保留 ----
ISUP_ALARM_RETENTION_DAYS=30
ISUP_IMAGE_RETENTION_DAYS=30
ISUP_VIDEO_RETENTION_DAYS=7
ISUP_CLEANUP_ON_STARTUP=true
ISUP_CLEANUP_INTERVAL_HOURS=24

# ---- 视频（按需回放；ISAPI 走边缘盒子）----
ISUP_VIDEO_PROVIDER=file
ISUP_VIDEO_USE_ISAPI=true
ISUP_ISAPI_HOST=192.168.1.64
ISUP_ISAPI_PORT=80
ISUP_ISAPI_USERNAME=admin
# ★ 填盒子/设备网页管理员密码；不对则自动降级到 SDK 回放
ISUP_ISAPI_PASSWORD=STSXY304
ISUP_ISAPI_MAX_CONCURRENT=3
