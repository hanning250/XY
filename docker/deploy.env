# ISUP 告警平台 —— 本机部署环境（192.168.1.221）

# ---- ISUP 核心 ----
ISUP_SERVER_IP=192.168.1.221
ISUP_KEY=STSXY304
ISUP_LISTEN_IP=0.0.0.0
ISUP_CMS_PORT=7661
ISUP_AMS_TCP_PORT=7663
ISUP_AMS_UDP_PORT=7662
ISUP_SS_PORT=6011
ISUP_SMS_PORT=7665
ISUP_SMS_BACK_PORT=8000

# ---- Web ----
ISUP_HOST=0.0.0.0
ISUP_PORT=8088
ISUP_PUBLIC_BASE_URL=http://192.168.1.221:8088
ISUP_DEBUG=false

# ---- 功能开关 ----
ISUP_ENABLE_ISUP_SDK=true
ISUP_ENABLE_INTERNAL_API=true
ISUP_ENABLE_WEB_UI=true
ISUP_OPEN_API_REQUIRES_KEY=false

# ---- 鉴权（本机先匿名，方便打开看板；生产可改 jwt）----
ISUP_AUTH_MODE=anonymous
ISUP_JWT_SECRET=local-dev-change-me-please-use-random
ISUP_JWT_EXPIRE_MINUTES=720

# ---- 授权（本机关闭强制，避免挡业务）----
ISUP_LICENSE_DAYS=365
ISUP_LICENSE_ENFORCE=false
ISUP_LICENSE_SECRET=local-license-secret-change-me

# ---- 告警保留 ----
ISUP_ALARM_RETENTION_DAYS=30
ISUP_IMAGE_RETENTION_DAYS=30
ISUP_VIDEO_RETENTION_DAYS=7
ISUP_CLEANUP_ON_STARTUP=true
ISUP_CLEANUP_INTERVAL_HOURS=24

# ---- 视频（本机暂不配 NVR ISAPI，可按需补）----
ISUP_VIDEO_USE_ISAPI=false
ISUP_VIDEO_PROVIDER=file
